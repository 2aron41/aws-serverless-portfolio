aws_region      = "us-east-1"
project_name    = "aws-serverless-portfolio"
environment     = "prod"
github_username = "2aron41"

# Existing production bucket identified during Day 25 inventory.
bucket_name = "replace-with-existing-production-bucket-name"

# Match the existing production configuration before proposing improvements.
enable_versioning      = false
enable_encryption      = true
enable_cloudfront      = true
default_root_object    = "index.html"
cloudfront_price_class   = "PriceClass_All"
cloudfront_allowed_methods = ["GET", "HEAD"]

# Replace these placeholders with values reverified from private AWS evidence
# immediately before any production import.
cloudfront_comment                   = ""
cloudfront_origin_id                 = "replace-with-existing-production-origin-id"
cloudfront_oac_name                  = "replace-with-existing-production-oac-name"
cloudfront_oac_description           = "Created by CloudFront"
cloudfront_source_arn_condition_test = "ArnLike"

purpose = "Production portfolio website"
